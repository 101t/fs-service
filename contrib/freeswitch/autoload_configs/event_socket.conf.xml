<!--
  mod_event_socket for fs-service.
  * Listens on loopback only: run fs-service on the same host (or put both on a private network
    and change listen-ip + the ACL).
  * Replace the password (openssl rand -hex 24) and set the same value in FSS_ESL_PASSWORD.
    Never keep the stock "ClueCon": the event socket can run any FreeSWITCH command.
-->
<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="127.0.0.1"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="CHANGE_ME_ESL_PASSWORD"/>
    <param name="apply-inbound-acl" value="loopback.auto"/>
  </settings>
</configuration>
