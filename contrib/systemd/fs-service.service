# Bare-metal install next to FreeSWITCH:
#   sudo install -m 0755 target/release/fs-service /usr/local/bin/
#   sudo install -m 0640 -o root -g freeswitch .env /etc/fs-service.env   # fill it in first
#   sudo cp contrib/systemd/fs-service.service /etc/systemd/system/
#   sudo systemctl enable --now fs-service
#
# Runs as the freeswitch user so it can write gateway XML that FreeSWITCH reads,
# and FreeSWITCH can read uploads and write received faxes.
[Unit]
Description=fs-service - REST gateway for FreeSWITCH
After=network-online.target freeswitch.service
Wants=network-online.target

[Service]
User=freeswitch
Group=freeswitch
EnvironmentFile=/etc/fs-service.env
StateDirectory=fs-service
WorkingDirectory=/var/lib/fs-service
ExecStart=/usr/local/bin/fs-service
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fs-service /etc/freeswitch/sip_profiles/external
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
