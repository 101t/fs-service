# Copy to .env and fill in. Every setting is also a CLI flag: run `fs-service --help`.

# --- Required -------------------------------------------------------------
# One or more API tokens, comma-separated, 32+ chars each:  openssl rand -hex 32
FSS_API_TOKENS=
# Event socket password, read by fs-service AND by FreeSWITCH (contrib/.../event_socket.conf.xml)
# openssl rand -hex 24
FSS_ESL_PASSWORD=

# --- FreeSWITCH -------------------------------------------------------------
FSS_ESL_ADDR=127.0.0.1:8021
FSS_SIP_PROFILE=external
FSS_GATEWAY_DIR=/etc/freeswitch/sip_profiles/external

# --- Storage ----------------------------------------------------------------
FSS_DATABASE_URL=sqlite:///var/lib/fs-service/fs-service.db
FSS_OUTBOX_DIR=/var/lib/fs-service/outbox
FSS_INBOX_DIR=/var/lib/fs-service/inbox

# --- Limits & tuning --------------------------------------------------------
FSS_LISTEN=0.0.0.0:8080
FSS_MAX_UPLOAD_MB=25
FSS_MAX_NUMBERS=1000
FSS_DIAL_RATE=10
FSS_CONVERT_CONCURRENCY=2
FSS_CONVERT_TIMEOUT_SECS=120
FSS_MAGICK_BIN=convert

# --- Logging ----------------------------------------------------------------
FSS_LOG_JSON=false
RUST_LOG=info
